    <string name="explainer_categories_note">QuietBuzz changes these</string>
    <string name="explainer_category_a">Messages</string>
    <string name="explainer_category_b">Promotions</string>
    <string name="explainer_vibration_off">Vibration off</string>
    <string name="status_restore_all_hint">Puts each app back the way it was before QuietBuzz changed it, using what QuietBuzz saved at the time.</string>
    <string name="status_reset_all_hint">Ignores that saved record and turns sound and vibration back on for every app. Use this if apps are still muted after Restore all.</string>
    <string name="status_run_title">Run now?</string>
    <string name="status_run_body">Turns off vibration for every app not on your allowlist. Their notifications still show up, and sound follows your ringer mode.</string>
    <string name="status_run_confirm">Run</string>
    <string name="status_restore_title">Restore all?</string>
    <string name="status_restore_body">Puts each app back the way it was before QuietBuzz changed it, using what QuietBuzz saved at the time. The saved record is then cleared.\n\nIf apps are still muted afterwards, use Reset all to defaults.</string>
