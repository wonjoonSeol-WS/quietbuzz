    <string name="onboarding_title">Before you start</string>
    <string name="onboarding_subtitle">QuietBuzz needs three things before it can work.</string>
    <string name="onboarding_notification_access_title">Notification access</string>
    <string name="onboarding_notification_access_body">Lets QuietBuzz turn off vibration for apps that aren\'t on your allowlist. Their notifications still show up.</string>
    <string name="onboarding_bluetooth_title">Link a device</string>
    <string name="onboarding_bluetooth_body">Normal apps can\'t change other apps\' settings. Linking one Bluetooth or Wi-Fi device registers QuietBuzz as a linked-device app, like a smartwatch app, which Android allows to change other apps\' notification settings. Pick any device you own, like earbuds or a watch. QuietBuzz never actually connects to it.</string>
    <string name="onboarding_notifications_title">QuietBuzz alerts</string>
    <string name="onboarding_notifications_body">Optional. Lets QuietBuzz tell you if the device link stops working.</string>
