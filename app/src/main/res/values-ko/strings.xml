    <!-- Onboarding -->
    <string name="onboarding_title">시작하기 전에</string>
    <string name="onboarding_subtitle">QuietBuzz가 동작하려면 권한 3가지가 필요합니다. 각각 왜 필요한지 알려드릴게요.</string>
    <string name="onboarding_notification_access_title">알림 접근 권한</string>
    <string name="onboarding_notification_access_body">다른 앱의 알림 설정을 읽고 조정할 수 있게 해주는 권한입니다 -- 구체적으로는, 알림을 완전히 끄는 대신 채널의 중요도를 낮춰 조용하게 유지합니다.</string>
    <string name="onboarding_bluetooth_title">주변 기기 (블루투스)</string>
    <string name="onboarding_bluetooth_body">안드로이드는 다른 앱의 알림 설정을 바꿀 수 있는 앱을, 시스템 전체에서 단 하나뿐인 알림 어시스턴트이거나 CompanionDeviceManager로 기기와 연결된 앱, 이 두 경우로만 제한합니다. QuietBuzz는 두 번째 방법을 사용합니다. 근처 기기 아무거나(블루투스든 Wi-Fi든 상관없습니다)와 연결하면 이 조건을 만족합니다 -- 이후 그 기기는 전혀 사용되지 않습니다. 연결이 아니라 권한 토큰일 뿐입니다. 회사나 공용 기기보다는 본인 소유의 기기(휴대폰, 이어폰, 워치, 노트북 등)를 고르시는 걸 권장합니다 -- 일부 기기 종류는 이 과정에서 실제 블루투스 페어링(본딩)이 함께 일어날 수 있어, 공용 기기에 내 휴대폰이 페어링된 기록이 남을 수 있기 때문입니다.</string>
    <string name="onboarding_notifications_title">QuietBuzz 자체의 알림 권한</string>
    <string name="onboarding_notifications_body">연결된 기기의 권한이 해제되어 다시 연결이 필요할 때 알려드리기 위해서입니다.</string>
